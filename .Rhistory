library(tidyverse)
sample_info <- pheno %>%
rownames_to_column("geo_accession_row") %>%
transmute(
gsm = geo_accession,
barcode = `barcode:ch1`,
cell_line = `cell line:ch1`,
fraction = `fraction:ch1`,
replicate = `replicate:ch1`,
treatment_raw = `treatment:ch1`
) %>%
separate(treatment_raw, into = c("oxygen", "drug"), sep = "\\+", fill = "right") %>%
mutate(
drug = ifelse(is.na(drug), "Control", drug),
fraction = recode(fraction, "Total mRNA" = "Total", "Polysomal mRNA" = "Polysomal"),
replicate = recode(replicate, "Biological replicate 1" = "Rep1", "Biological replicate 2" = "Rep2")
)
sample_info
View(pheno)
# Combine both count matrices (same 60,554 genes, different samples)
counts_combined <- cbind(counts_01, counts_02)
dim(counts_combined)  # should be 60554 genes x 32 samples
# Build a named vector: barcode -> gsm, using sample_info
barcode_to_gsm <- setNames(sample_info$gsm, sample_info$barcode)
# Rename columns of the combined counts matrix from barcode to GSM accession
colnames(counts_combined) <- barcode_to_gsm[colnames(counts_combined)]
# Check for any NAs introduced (would mean a barcode didn't match)
sum(is.na(colnames(counts_combined)))
# Reorder columns to match sample_info row order, and reorder sample_info to match
counts_combined <- counts_combined[, sample_info$gsm]
# Confirm alignment
all(colnames(counts_combined) == sample_info$gsm)
dim(counts_combined)
sum(is.na(colnames(counts_combined)))
library(DESeq2)
# Set rownames of sample_info to GSM so it aligns with count matrix columns
coldata <- sample_info
rownames(coldata) <- coldata$gsm
# Convert relevant columns to factors, setting sensible reference levels
coldata$cell_line <- factor(coldata$cell_line, levels = c("MCF10A", "MDA-MB-231"))
coldata$fraction  <- factor(coldata$fraction, levels = c("Total", "Polysomal"))
coldata$oxygen    <- factor(coldata$oxygen, levels = c("Normoxia", "Hypoxia"))
coldata$drug      <- factor(coldata$drug, levels = c("Control", "PP242"))
coldata$replicate <- factor(coldata$replicate)
# Sanity check: rownames of coldata must exactly match colnames of counts
all(rownames(coldata) == colnames(counts_combined))
# Round counts (RSEM expected counts are non-integer; DESeq2 needs integers)
counts_int <- round(as.matrix(counts_combined))
# Build the DESeqDataSet (we'll finalize the design formula in Step 5 —
# using a placeholder full-factorial design for now so we can do QC)
dds <- DESeqDataSetFromMatrix(
countData = counts_int,
colData = coldata,
design = ~ cell_line + oxygen + drug + fraction
)
dds
# Keep genes with at least 10 reads total across a reasonable number of samples
keep <- rowSums(counts(dds) >= 10) >= 4
dds <- dds[keep, ]
dim(dds)
library_sizes <- colSums(counts(dds))
sort(library_sizes)
barplot(library_sizes, las = 2, cex.names = 0.6,
main = "Library sizes per sample", ylab = "Total counts")
vsd <- vst(dds, blind = TRUE)
library(ggplot2)
pca_data <- plotPCA(vsd, intgroup = c("cell_line", "oxygen", "drug", "fraction"), returnData = TRUE)
percentVar <- round(100 * attr(pca_data, "percentVar"))
ggplot(pca_data, aes(x = PC1, y = PC2, color = cell_line, shape = fraction)) +
geom_point(size = 3) +
xlab(paste0("PC1: ", percentVar[1], "% variance")) +
ylab(paste0("PC2: ", percentVar[2], "% variance")) +
theme_bw()
ggplot(pca_data, aes(x = PC1, y = PC2, color = oxygen, shape = drug)) +
geom_point(size = 3) +
xlab(paste0("PC1: ", percentVar[1], "% variance")) +
ylab(paste0("PC2: ", percentVar[2], "% variance")) +
theme_bw()
dds <- DESeqDataSetFromMatrix(
countData = counts_int,
colData = coldata,
design = ~ cell_line + oxygen + drug + fraction + cell_line:oxygen + oxygen:fraction
)
# Re-apply the same low-count filter as before
keep <- rowSums(counts(dds) >= 10) >= 4
dds <- dds[keep, ]
dim(dds)
dds <- DESeq(dds)
plotDispEsts(dds)
resultsNames(dds)
# Hypoxia effect in MCF10A (reference cell line), Total fraction
res_hypoxia_MCF10A <- results(dds, name = "oxygen_Hypoxia_vs_Normoxia")
# Hypoxia effect in MDA-MB-231 (combine main effect + cell_line:oxygen interaction)
res_hypoxia_MDAMB231 <- results(dds, contrast = list(c("oxygen_Hypoxia_vs_Normoxia", "cell_lineMDA.MB.231.oxygenHypoxia")))
# Does the hypoxia effect significantly DIFFER between cell lines? (the interaction term itself)
res_interaction_cellline_oxygen <- results(dds, name = "cell_lineMDA.MB.231.oxygenHypoxia")
# Does the hypoxia effect significantly differ between Total vs Polysomal fraction?
# (this is your translational-efficiency-under-hypoxia result — the most novel part of the project)
res_interaction_oxygen_fraction <- results(dds, name = "oxygenHypoxia.fractionPolysomal")
# Hypoxia effect specifically in the Polysomal fraction (MCF10A reference)
res_hypoxia_polysomal <- results(dds, contrast = list(c("oxygen_Hypoxia_vs_Normoxia", "oxygenHypoxia.fractionPolysomal")))
summary(res_hypoxia_MCF10A)
summary(res_hypoxia_MDAMB231)
summary(res_interaction_cellline_oxygen)
summary(res_interaction_oxygen_fraction)
summary(res_hypoxia_polysomal)
res_hypoxia_MCF10A_shrunk <- lfcShrink(dds, coef = "oxygen_Hypoxia_vs_Normoxia", type = "apeglm")
res_interaction_cellline_oxygen_shrunk <- lfcShrink(dds, coef = "cell_lineMDA.MB.231.oxygenHypoxia", type = "apeglm")
# rownames look like: "ENSG00000223972.5,DDX11L1,transcribed_unprocessed_pseudogene"
gene_info <- data.frame(
full_id = rownames(dds),
ensembl_id = sapply(strsplit(rownames(dds), ","), `[`, 1),
gene_symbol = sapply(strsplit(rownames(dds), ","), `[`, 2),
biotype = sapply(strsplit(rownames(dds), ","), `[`, 3)
)
head(gene_info)
any(duplicated(gene_info$gene_symbol))
library(ggplot2)
volcano_df <- as.data.frame(res_hypoxia_MCF10A_shrunk)
volcano_df$gene_symbol <- gene_info$gene_symbol[match(rownames(volcano_df), gene_info$full_id)]
volcano_df$sig <- ifelse(!is.na(volcano_df$padj) & volcano_df$padj < 0.05 & abs(volcano_df$log2FoldChange) > 1,
"Significant", "Not significant")
ggplot(volcano_df, aes(x = log2FoldChange, y = -log10(pvalue), color = sig)) +
geom_point(alpha = 0.5, size = 1) +
scale_color_manual(values = c("Significant" = "firebrick", "Not significant" = "grey70")) +
theme_bw() +
labs(title = "Hypoxia vs Normoxia (MCF10A, Total mRNA)",
x = "log2 Fold Change (shrunk)", y = "-log10(p-value)")
volcano_df2 <- as.data.frame(res_interaction_cellline_oxygen_shrunk)
volcano_df2$gene_symbol <- gene_info$gene_symbol[match(rownames(volcano_df2), gene_info$full_id)]
volcano_df2$sig <- ifelse(!is.na(volcano_df2$padj) & volcano_df2$padj < 0.05 & abs(volcano_df2$log2FoldChange) > 1,
"Significant", "Not significant")
ggplot(volcano_df2, aes(x = log2FoldChange, y = -log10(pvalue), color = sig)) +
geom_point(alpha = 0.5, size = 1) +
scale_color_manual(values = c("Significant" = "steelblue", "Not significant" = "grey70")) +
theme_bw() +
labs(title = "Cell line x Oxygen interaction (does hypoxia response differ MCF10A vs MDA-MB-231?)",
x = "log2 Fold Change (shrunk)", y = "-log10(p-value)")
top_hypoxia_genes <- volcano_df %>%
filter(!is.na(padj)) %>%
arrange(padj) %>%
select(gene_symbol, log2FoldChange, padj) %>%
head(20)
top_hypoxia_genes
library(pheatmap)
# Get top 30 genes by adjusted p-value
top30 <- volcano_df %>%
filter(!is.na(padj)) %>%
arrange(padj) %>%
head(30)
# Extract variance-stabilized expression for these genes, MCF10A samples only (matches our contrast)
mcf10a_samples <- rownames(coldata)[coldata$cell_line == "MCF10A" & coldata$fraction == "Total"]
mat <- assay(vsd)[rownames(top30), mcf10a_samples]
# Center each gene's expression (row-wise z-score) for better visual contrast
mat_scaled <- t(scale(t(mat)))
rownames(mat_scaled) <- top30$gene_symbol
# Annotation for columns (oxygen, drug)
annotation_col <- data.frame(
Oxygen = coldata[mcf10a_samples, "oxygen"],
Drug = coldata[mcf10a_samples, "drug"]
)
rownames(annotation_col) <- mcf10a_samples
pheatmap(mat_scaled, annotation_col = annotation_col,
main = "Top 30 Hypoxia-Responsive Genes (MCF10A, Total mRNA)")
library(clusterProfiler)
library(org.Hs.eg.db)
# Use the full hypoxia (MCF10A) results, ranked by shrunk log2FC for GSEA
gsea_input <- volcano_df %>%
filter(!is.na(gene_symbol), !is.na(log2FoldChange)) %>%
distinct(gene_symbol, .keep_all = TRUE)  # handle duplicate symbols by keeping first occurrence
# Map SYMBOL -> ENTREZID
gene_map <- bitr(gsea_input$gene_symbol, fromType = "SYMBOL", toType = "ENTREZID", OrgDb = org.Hs.eg.db)
gsea_input <- gsea_input %>%
inner_join(gene_map, by = c("gene_symbol" = "SYMBOL"))
nrow(gsea_input)
head(gene_map)
# Check for duplicate ENTREZ IDs from the 1:many mapping
sum(duplicated(gsea_input$ENTREZID))
# Deduplicate: keep first occurrence per ENTREZID
gsea_input <- gsea_input %>%
distinct(ENTREZID, .keep_all = TRUE)
nrow(gsea_input)
ranked_genes <- gsea_input$log2FoldChange
names(ranked_genes) <- gsea_input$ENTREZID
ranked_genes <- sort(ranked_genes, decreasing = TRUE)
head(ranked_genes)
tail(ranked_genes)
length(ranked_genes)
# Install if needed
if (!requireNamespace("msigdbr", quietly = TRUE)) {
install.packages("msigdbr")
}
library(msigdbr)
# Get Hallmark gene sets for human, formatted for clusterProfiler
hallmark_sets <- msigdbr(species = "Homo sapiens", category = "H") %>%
dplyr::select(gs_name, entrez_gene)
head(hallmark_sets)
set.seed(42)
gsea_result <- GSEA(
geneList = ranked_genes,
TERM2GENE = hallmark_sets,
pvalueCutoff = 0.05,
eps = 0
)
gsea_df <- as.data.frame(gsea_result) %>%
arrange(desc(NES))
gsea_df[, c("ID", "NES", "pvalue", "p.adjust")]
View(gsea_result)
library(enrichplot)
gseaplot2(gsea_result, geneSetID = "HALLMARK_HYPOXIA",
title = "HALLMARK_HYPOXIA enrichment (Hypoxia vs Normoxia, MCF10A)")
